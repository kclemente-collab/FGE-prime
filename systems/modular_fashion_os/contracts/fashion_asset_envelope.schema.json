{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fge.local/contracts/fashion_asset_envelope.schema.json",
  "title": "FGE Fashion Asset Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_id",
    "version",
    "status",
    "canon_effect",
    "identity",
    "provenance",
    "rights",
    "garment",
    "representations",
    "validation"
  ],
  "properties": {
    "object_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"type": "string"},
    "canon_effect": {"enum": ["NONE", "PROPOSED", "AUTHORIZED", "LOCKED"]},
    "identity": {
      "type": "object",
      "additionalProperties": true,
      "required": ["asset_id", "asset_class", "display_name"],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1},
        "asset_class": {"enum": ["GARMENT", "ACCESSORY", "FOOTWEAR", "JEWELRY", "ARMOR", "OTHER"]},
        "display_name": {"type": "string", "minLength": 1},
        "sku": {"type": ["string", "null"]},
        "brand": {"type": ["string", "null"]},
        "rarity": {"type": ["string", "null"]}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source_type"],
      "properties": {
        "source_type": {"enum": ["USER_SUPPLIED", "FGE_GENERATED", "IMPORTED", "LICENSED", "UNKNOWN"]},
        "creator_id": {"type": ["string", "null"]},
        "source_uri": {"type": ["string", "null"]},
        "content_hash": {"type": ["string", "null"]},
        "created_at": {"type": ["string", "null"]},
        "authority_notes": {"type": ["string", "null"]}
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commercial_use", "rental_allowed", "redistribution_allowed", "license_id", "modification_operations", "platform_authorizations", "valuation"],
      "properties": {
        "commercial_use": {"type": "boolean"},
        "rental_allowed": {"type": "boolean"},
        "redistribution_allowed": {"type": "boolean"},
        "license_id": {"type": "string", "minLength": 1},
        "modification_operations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["color_tint", "pattern_overlay", "material_substitution", "fit_morph"],
          "properties": {
            "color_tint": {"type": "boolean"},
            "pattern_overlay": {"type": "boolean"},
            "material_substitution": {"type": "boolean"},
            "fit_morph": {"type": "boolean"}
          }
        },
        "platform_authorizations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "status", "license_id"],
            "properties": {
              "target": {"type": "string", "minLength": 1},
              "status": {"enum": ["AUTHORIZED", "DENIED", "EXPIRED", "UNKNOWN"]},
              "license_id": {"type": "string", "minLength": 1},
              "expires_at": {"type": ["string", "null"], "format": "date-time"}
            }
          }
        },
        "valuation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["currency", "base_value_minor", "royalty_bps", "recipients"],
          "properties": {
            "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
            "base_value_minor": {"type": "integer", "minimum": 0},
            "royalty_bps": {"type": "integer", "minimum": 0, "maximum": 10000},
            "recipients": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["recipient_id", "share_bps"],
                "properties": {
                  "recipient_id": {"type": "string", "minLength": 1},
                  "share_bps": {"type": "integer", "minimum": 0, "maximum": 10000}
                }
              }
            }
          }
        }
      }
    },
    "garment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geometry", "fit", "layering", "coverage", "material", "physics"],
      "properties": {
        "geometry": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "master_format": {"type": ["string", "null"]},
            "master_uri": {"type": ["string", "null"]},
            "bind_pose": {"type": ["string", "null"]},
            "vertex_count": {"type": ["integer", "null"], "minimum": 0}
          }
        },
        "fit": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "source_body_profile": {"type": ["string", "null"]},
            "rig_compatibility": {"type": "array", "items": {"type": "string"}},
            "anchor_points": {"type": "array", "items": {"type": "string"}},
            "morph_strategy": {"type": ["string", "null"]},
            "fit_tolerance_mm": {"type": ["number", "null"], "minimum": 0}
          }
        },
        "layering": {
          "type": "object",
          "additionalProperties": false,
          "required": ["layer_class", "layer_priority", "compatible_over_layers", "compatible_under_layers", "occlusion"],
          "properties": {
            "layer_class": {"type": "string", "minLength": 1},
            "layer_priority": {"type": "integer", "minimum": 0, "maximum": 100},
            "compatible_over_layers": {"type": "array", "items": {"type": "string"}},
            "compatible_under_layers": {"type": "array", "items": {"type": "string"}},
            "occlusion": {
              "type": "object",
              "additionalProperties": false,
              "required": ["deactivation_zones_skin", "push_out_distance_mm", "collision_channel", "normal_offset_falloff_power"],
              "properties": {
                "deactivation_zones_skin": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
                "push_out_distance_mm": {"type": "number", "minimum": 0, "maximum": 25},
                "collision_channel": {"type": "string", "minLength": 1},
                "normal_offset_falloff_power": {"type": "number", "exclusiveMinimum": 0}
              }
            }
          }
        },
        "coverage": {
          "type": "object",
          "description": "Body and garment coverage graph. Region values should describe COVER, PARTIAL, OPEN or UNKNOWN.",
          "additionalProperties": {"enum": ["COVER", "PARTIAL", "OPEN", "UNKNOWN"]}
        },
        "material": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "material_chip_id": {"type": ["string", "null"]},
            "fabric_id": {"type": ["string", "null"]},
            "physical_intent": {"type": "object", "additionalProperties": true},
            "optical_intent": {"type": "object", "additionalProperties": true},
            "tactile_intent": {"type": "object", "additionalProperties": true},
            "aging_intent": {"type": "object", "additionalProperties": true}
          }
        },
        "physics": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "profile_id": {"type": ["string", "null"]},
            "solver_neutral": {"type": "object", "additionalProperties": true},
            "fallback_behavior": {"type": ["string", "null"]}
          }
        },
        "customization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "rgba_control_texture_uri", "max_pattern_tiling_scale", "color_tints", "pattern_overlays"],
          "properties": {
            "enabled": {"type": "boolean"},
            "rgba_control_texture_uri": {"type": ["string", "null"]},
            "max_pattern_tiling_scale": {"type": "number", "exclusiveMinimum": 0},
            "color_tints": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["channel", "semantic", "default_hex", "runtime_override_allowed"],
                "properties": {
                  "channel": {"enum": ["R", "G", "B", "A"]},
                  "semantic": {"enum": ["PRIMARY_TEXTILE", "SECONDARY_ACCENT", "RIGID_HARDWARE", "ROUGHNESS_WEAR"]},
                  "default_hex": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
                  "runtime_override_allowed": {"type": "boolean"}
                }
              }
            },
            "pattern_overlays": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["pattern_id", "tiling_frequency", "uv_channel_index", "offset_speed", "blend_mode"],
                "properties": {
                  "pattern_id": {"type": "string", "minLength": 1},
                  "tiling_frequency": {"type": "array", "prefixItems": [{"type": "number", "exclusiveMinimum": 0}, {"type": "number", "exclusiveMinimum": 0}], "items": false},
                  "uv_channel_index": {"type": "integer", "minimum": 0, "maximum": 7},
                  "offset_speed": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "items": false},
                  "blend_mode": {"enum": ["LERP_BASE_COLOR", "LERP_SUBSTRATE_SLAB_ROUGHNESS", "MULTIPLY", "OVERLAY"]}
                }
              }
            }
          }
        }
      }
    },
    "representations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "runtime", "adapters"],
      "properties": {
        "source": {"type": "array", "items": {"$ref": "#/$defs/representation"}},
        "runtime": {"type": "array", "items": {"$ref": "#/$defs/representation"}},
        "adapters": {"type": "array", "items": {"$ref": "#/$defs/adapterRepresentation"}}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["state"],
      "properties": {
        "state": {"enum": ["UNKNOWN", "PENDING", "PARTIAL", "PASSED", "FAILED"]},
        "gates": {"type": "object", "additionalProperties": {"type": "string"}},
        "conflicts": {"type": "array", "items": {"type": "string"}},
        "unknowns": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "representation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["representation_id", "format"],
      "properties": {
        "representation_id": {"type": "string"},
        "format": {"type": "string"},
        "uri": {"type": ["string", "null"]},
        "lod": {"type": ["integer", "null"], "minimum": 0},
        "hash": {"type": ["string", "null"]},
        "status": {"type": ["string", "null"]}
      }
    },
    "adapterRepresentation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["adapter_id", "target"],
      "properties": {
        "adapter_id": {"type": "string"},
        "target": {"type": "string"},
        "rig_profile": {"type": ["string", "null"]},
        "material_profile": {"type": ["string", "null"]},
        "physics_profile": {"type": ["string", "null"]},
        "physics_solver": {"type": ["string", "null"]},
        "asset_uri": {"type": ["string", "null"]},
        "runtime_status": {"enum": ["LIVE", "CANDIDATE", "UNAVAILABLE"]},
        "live_runtime": {"type": "boolean"},
        "capabilities": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
