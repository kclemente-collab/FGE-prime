{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fge.local/schema/payloads/storage_module.json",
  "title": "FGE Fashion Storage Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_type", "asset_id", "version", "path", "content_hash", "authority", "index_state"],
  "properties": {
    "receipt_type": {"const": "FGE_FASHION_STORAGE_RECEIPT"},
    "asset_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "path": {"type": "string", "minLength": 1},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "asset_commit": {"type": ["string", "null"]},
    "index_commit": {"type": ["string", "null"]},
    "authority": {"const": "GITHUB_PERSISTENCE"},
    "index_state": {"enum": ["REGISTERED", "RECOVERED"]},
    "recovery_attempts": {"type": "integer", "minimum": 0}
  }
}
